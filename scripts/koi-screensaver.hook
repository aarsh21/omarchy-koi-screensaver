#!/bin/bash
# Restore only session shims that an Omarchy update reset to their stock executables.
set -e

bin=/usr/local/bin/koi-screensaver
[[ -x $bin ]] || exit 0

# Only a reset to Omarchy's stock target belongs to us. A later custom screensaver or a changed
# integration layout is the user's choice, not an update we should undo.
restore=()
for name in omarchy-screensaver omarchy-launch-screensaver; do
  shim=/usr/share/omarchy/bin/$name
  if [[ -L $shim && "$(readlink -f "$shim")" == /usr/bin/"$name" ]]; then
    restore+=("$shim")
  fi
done
[[ ${#restore[@]} -gt 0 ]] || exit 0

if ! sudo -n true 2>/dev/null; then
  omarchy-notification-send -u critical -g "󰈺" "Koi pond screensaver needs reinstalling" \
    "Re-run the setup command from the project README to restore it after the Omarchy update." \
    --exec "omarchy-launch-web https://github.com/aarsh21/omarchy-koi-screensaver#install-and-launch"
  exit 0
fi

for shim in "${restore[@]}"; do
  sudo ln -sfn "$bin" "$shim"
done
omarchy-notification-send -g "󰈺" "Koi pond screensaver restored after the Omarchy update"
